{
  "name": "fieldrelay-workspace",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "//packageManager": "Pinned so corepack resolves the same pnpm everywhere. A newer pnpm stops reading pnpm.overrides from package.json and refuses the frozen lockfile, which broke the Docker build.",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "@angular-devkit/core": "20.3.27",
      "@angular-devkit/schematics": "20.3.27",
      "@babel/core": ">=7.29.6",
      "esbuild": ">=0.28.1",
      "qs": ">=6.15.2",
      "http-proxy-middleware": ">=3.0.7",
      "picomatch": ">=4.0.4",
      "piscina": ">=4.9.3",
      "postcss": ">=8.5.12",
      "serialize-javascript": ">=7.0.3",
      "typescript": "~5.8.2",
      "uuid": ">=11.1.1",
      "webpack-dev-server": ">=5.2.6",
      "vite": "7.3.5"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-win32-x64-msvc": "0.121.0"
  }
}
