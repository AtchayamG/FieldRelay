# Normalize line endings in the repository regardless of contributor platform.
# Text files are stored with LF; git checks them out using each platform's
# native convention. This removes the dependency on per-machine core.autocrlf.

* text=auto

# Explicit text types (keeps diffs stable for tooling that sniffs content).
*.ts        text
*.js        text
*.mjs       text
*.json      text
*.md        text
*.html      text
*.css       text
*.scss      text
*.yml       text
*.yaml      text
*.sql       text
*.py        text

# Files that must stay LF even on Windows checkouts.
*.sh        text eol=lf
Dockerfile* text eol=lf

# Binary assets: never diffed, never normalized.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary

# Generated lockfile: keep it out of diff review noise.
pnpm-lock.yaml -diff linguist-generated
