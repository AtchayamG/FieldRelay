# FieldRelay environment template.
#
# Copy to .env for Docker Compose interpolation, or export the required values
# in the shell that starts the API. .env is git-ignored.
# This file contains no secrets: every value below is a local development
# placeholder. Never paste a real credential, API key or phone number here.

# --- API -------------------------------------------------------------------

PORT=3000

# Comma-separated exact browser origins allowed to call this API. Wildcard CORS
# is intentionally unsupported and there is no wildcard fallback: when unset,
# only the local Angular dev servers (http://localhost:4200 and
# http://localhost:4173) are permitted.
FRONTEND_ORIGINS=http://localhost:4200,http://localhost:4173

# --- Session authentication ------------------------------------------------
#
# Required. Signs the session tokens the API issues, using HMAC-SHA256. The
# process refuses to start without at least 32 characters, because a weak
# secret here means anyone can mint a session. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SIGNING_SECRET=local_dev_auth_secret_change_me_at_least_32_chars

# The evaluator credentials. These are deliberately published — on the sign-in
# screen, in the README and in the Devpost testing instructions — so judges can
# get in without being handed a secret out of band. This is an access boundary,
# not an identity system: what stops a public deployment placing real calls is
# CALL_E_MODE, not this password.
DEMO_OPERATOR_EMAIL=ops.demo@fieldrelay.io
DEMO_OPERATOR_PASSWORD=DemoOps2026!

# --- PostgreSQL ------------------------------------------------------------
#
# Required. The API refuses to start without DATABASE_URL: incidents, audit
# events and idempotency records are never held in memory in a deployment.
# GET /health runs a real query, so it fails if the database is unreachable.
#
# The values below match the docker-compose `postgres` service defaults.
# For a managed database, append ?sslmode=require to enforce TLS.

POSTGRES_DB=fieldrelay
POSTGRES_USER=fieldrelay
POSTGRES_PASSWORD=fieldrelay_local_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql://fieldrelay:fieldrelay_local_dev@127.0.0.1:5432/fieldrelay

# --- CALL-E ----------------------------------------------------------------
#
# CALL_E_MODE selects the adapter behind CallEPort. Anything other than the
# exact value "live" — including unset, empty, or a typo — selects the demo
# adapter, which never dials and always labels its results simulated: true.
# No environment can start placing real calls by accident.
#
#   demo (default) : no credential needed, no phone network action, ever.
#   live           : real outbound calls. Every variable below becomes
#                    required, and the process refuses to boot if any of them
#                    is missing or unsafe.

CALL_E_MODE=demo

# Required when CALL_E_MODE=live.
#
# CALLE_BASE_URL is the CALL-E Developer API host, verified reachable on
# 2026-07-25: a valid key returns a structured 404 for an unknown call, and an
# invalid key returns 401 unauthorized.
#
# CALLE_API_KEY is created self-service at
# https://dashboard.heycall-e.com/account/api-keys (2 keys per account, free,
# 90-day default expiry). The full key is displayed only once. Never commit it
# here — this file is a template; put the real value in .env, which is ignored.
# CALLE_BASE_URL=https://api.heycall-e.com
# CALLE_API_KEY=

# Optional bound on each provider HTTP request, 1000-60000 ms. Out-of-range
# values fall back to the 15000 ms default rather than being honoured.
# CALLE_REQUEST_TIMEOUT_MS=15000

# Where CALL-E posts terminal call results. Must be https and publicly
# reachable, and must carry the token below, because that token is the only
# thing authenticating the webhook route.
# CALLE_WEBHOOK_URL=https://fieldrelay.example.com/api/v1/call-e/webhook?token=REPLACE_ME
# CALLE_WEBHOOK_TOKEN=

# The only place a real phone number is allowed to exist. Numbers are read
# from the environment and never from the database, so a contact ID that looks
# authorized still cannot reach a real person unless an operator provisioned
# the number here. Never commit a real number to this file.
# Format: contactId=+E164|REGION|locale, comma-separated.
# Supported regions: US SG MY IN AE AU CA GB VN DE JP FR MX BR ID PH KE
# CALLE_DIAL_TARGETS=CNS-4491=+6512345678|SG|en-SG

# Lets an operator change the live call target from Settings inside the app,
# instead of editing CALLE_DIAL_TARGETS and restarting. Off unless set to
# exactly "true", so a public judge deployment cannot be pointed at an
# arbitrary telephone by anyone holding the published demo credentials.
#
# When on, a number entered in Settings takes precedence over CALLE_DIAL_TARGETS
# for the contact it is bound to. It is still validated as E.164, still
# restricted to CALL-E's supported regions, still bound to an authorized
# contact, and still subject to that contact's allowed purposes. Only the last
# four digits are ever shown back, and the audit trail records the masked form.
CALLE_ALLOW_RUNTIME_DIAL_TARGET=false

# Required by POST /api/v1/call-e/callbacks. The controller verifies an
# HMAC-SHA256 signature computed over "<timestamp>.<raw request bytes>" and
# refuses to start with a missing or weak secret (minimum 16 characters).
# The value below is a local development placeholder only: real environments
# must inject a high-entropy secret from their secret store and rotate it
# independently of this file.
CALLBACK_SIGNING_SECRET=local_dev_callback_secret_change_me
